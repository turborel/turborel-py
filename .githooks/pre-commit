#!/bin/sh
# Every check a change must pass, before each commit (RULES.md R-PROC-1).
# The checks live in `tools/verify.py`; this file only hands over to it,
# because git runs hooks as scripts (on Windows, through the sh Git for
# Windows ships). Install with `git config core.hooksPath .githooks`.
exec uv run --locked python -m tools.verify
